<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="in.org.csi.duketreadmillscore.MainActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center_vertical"
        android:layout_alignParentTop="true"
        android:id="@+id/mainScroll">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingBottom="@dimen/activity_vertical_margin"
            android:paddingLeft="@dimen/activity_horizontal_margin"
            android:paddingTop="@dimen/activity_vertical_margin">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:text="Exercise Time :"
                    android:layout_gravity="center_vertical"
                    android:textColor="#3F51B5"/>

                <EditText android:id="@+id/exerciseMinutes"
                    android:layout_width="@dimen/inputBoxWidth"
                    android:layout_height="@dimen/inputBoxHeight"
                    android:inputType="number"
                    android:layout_marginLeft="@dimen/activity_horizontal_margin"
                    android:paddingLeft="10dp"
                    android:imeOptions="actionDone"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:text=":"
                    android:layout_gravity="center_vertical" />

                <EditText android:id="@+id/exerciseSeconds"
                    android:layout_width="@dimen/inputBoxWidth"
                    android:layout_height="@dimen/inputBoxHeight"
                    android:inputType="number"
                    android:paddingLeft="10dp"
                    android:imeOptions="actionDone"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?android:attr/textAppearanceSmall"
                    android:text="Mins"
                    android:layout_marginLeft="150dp"
                    android:textColor="@color/colorPrimaryDark" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?android:attr/textAppearanceSmall"
                    android:text="Secs"
                    android:layout_marginLeft="35dp"
                    android:textColor="@color/colorPrimaryDark" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:text="Max ST :"
                    android:layout_gravity="center_vertical"
                    android:textColor="#3F51B5"/>

                <EditText android:id="@+id/maxST"
                    android:layout_width="@dimen/inputBoxWidth"
                    android:layout_height="@dimen/inputBoxHeight"
                    android:inputType="numberDecimal"
                    android:layout_marginLeft="@dimen/activity_horizontal_margin"
                    android:paddingLeft="10dp"
                    android:imeOptions="actionDone"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?android:attr/textAppearanceSmall"
                    android:text="mm"
                    android:layout_gravity="center_vertical"
                    android:textColor="@color/colorPrimaryDark"
                    android:layout_marginLeft="5dp" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:text="Angina Index :"
                android:layout_gravity="center_vertical"
                android:textColor="#3F51B5"
                android:layout_marginTop="@dimen/activity_vertical_margin"/>

            <RadioGroup
                android:id="@+id/anginaIndex"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/activity_vertical_margin">

                <RadioButton
                    android:id="@+id/index0"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0. No angina during exercise"
                    android:checked="true" />

                <RadioButton
                    android:id="@+id/index1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1. Non-limiting angina" />

                <RadioButton
                    android:id="@+id/index2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2. Exercise limited angina" />

            </RadioGroup>


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:text="Result : "
                android:layout_marginTop="@dimen/result_margin"
                android:layout_gravity="center_vertical"
                android:textColor="#B71C1C"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/activity_vertical_margin">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:text="DTS :"
                    android:layout_gravity="center_vertical"
                    android:textColor="#3F51B5"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:text=""
                    android:id="@+id/DTS"
                    android:layout_marginLeft="@dimen/activity_horizontal_margin"
                    android:layout_gravity="center_vertical"
                    android:textColor="@color/colorPrimaryDark"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/activity_vertical_margin">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:text="Risk :"
                    android:layout_gravity="center_vertical"
                    android:textColor="#3F51B5"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:text=""
                    android:id="@+id/risk"
                    android:layout_marginLeft="@dimen/activity_horizontal_margin"
                    android:layout_gravity="center_vertical"
                    android:textColor="@color/colorPrimaryDark"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/activity_vertical_margin"
                android:gravity="center">

                <Button
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Calculate"
                    android:id="@+id/calculate"
                    android:enabled="true"/>

                <Button
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Reset"
                    android:id="@+id/reset"
                    android:enabled="true"/>

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:text="Dts risk values for men and wemen : "
                android:layout_marginTop="@dimen/result_margin"
                android:layout_gravity="center_vertical"
                android:textColor="#B71C1C"/>

            <TableLayout
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:stretchColumns="1,2"
                android:paddingTop="@dimen/intern_row"
                android:paddingBottom="@dimen/intern_row"
                android:id="@+id/riskValues">

                <TableRow
                    android:paddingTop="@dimen/intern_row"
                    android:paddingBottom="@dimen/intern_row">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="?android:attr/textAppearanceMedium"
                        android:text="Risk Category"
                        android:layout_gravity="center_horizontal"
                        android:textColor="#3F51B5" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="?android:attr/textAppearanceMedium"
                        android:text="Men"
                        android:layout_gravity="center_horizontal"
                        android:textColor="#3F51B5" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="?android:attr/textAppearanceMedium"
                        android:text="Women"
                        android:layout_gravity="center_horizontal"
                        android:textColor="#3F51B5"/>

                </TableRow>
            </TableLayout>
        </LinearLayout>
    </ScrollView>
</RelativeLayout>
